{"program": "r11_jsmn_tokenizer", "tests": [{"id": 1, "args": [], "stdin": "{\"a\":1,\"b\":[true,false,null],\"c\":\"hi\"}", "expected_stdout": "0:OBJECT:{\"a\":1,\"b\":[true,false,null],\"c\":\"hi\"}\n1:STRING:a\n2:PRIMITIVE:1\n3:STRING:b\n4:ARRAY:[true,false,null]\n5:PRIMITIVE:true\n6:PRIMITIVE:false\n7:PRIMITIVE:null\n8:STRING:c\n9:STRING:hi\n"}, {"id": 2, "args": [], "stdin": "[]", "expected_stdout": "0:ARRAY:[]\n"}, {"id": 3, "args": [], "stdin": "{\"a\":", "expected_stdout": "PARSE_ERROR:-3\n"}, {"id": 4, "args": [], "stdin": "\"just a string\"", "expected_stdout": "0:STRING:just a string\n"}, {"id": 5, "args": [], "stdin": "{\"nested\":{\"x\":1,\"y\":2}}", "expected_stdout": "0:OBJECT:{\"nested\":{\"x\":1,\"y\":2}}\n1:STRING:nested\n2:OBJECT:{\"x\":1,\"y\":2}\n3:STRING:x\n4:PRIMITIVE:1\n5:STRING:y\n6:PRIMITIVE:2\n"}]}
