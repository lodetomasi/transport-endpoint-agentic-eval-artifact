{"program": "r10_ini_parser", "tests": [{"id": 1, "args": [], "stdin": "[server]\nhost = localhost\nport = 8080\n\n[client]\ntimeout=30\n", "expected_stdout": "server.host=localhost\nserver.port=8080\nclient.timeout=30\nOK\n"}, {"id": 2, "args": [], "stdin": "foo = bar\n[a]\nx=1\n", "expected_stdout": "GLOBAL.foo=bar\na.x=1\nOK\n"}, {"id": 3, "args": [], "stdin": "[unterminated\nkey=val\n", "expected_stdout": "GLOBAL.key=val\nERROR_LINE:1\n"}, {"id": 4, "args": [], "stdin": "", "expected_stdout": "OK\n"}, {"id": 5, "args": [], "stdin": "; just a comment\n[s]\nk=v ; inline comment\n", "expected_stdout": "s.k=v\nOK\n"}]}
